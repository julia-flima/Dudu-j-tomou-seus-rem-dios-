{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remédios do Dudu",
  "version": "1.0.0",
  "identifier": "io.github.juliaflima.remediosdodudu",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/copiar-web.mjs",
    "beforeDevCommand": "node scripts/copiar-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dudu já tomou seus remédios?",
        "width": 430,
        "height": 860,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
